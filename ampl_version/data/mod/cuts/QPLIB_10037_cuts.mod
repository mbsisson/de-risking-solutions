  {(cut,f,i,j) in nonzero_phiQuadWeights} X[i]*phiQuadWeights[cut,f,i,j]*X[j]
   + sum{(cut,f,i) in nonzero_phiLinWeights} phiLinWeights[cut,f,i]*X[i] +
  phiConstWeights[cut,f];
